{
  "name": "incidentos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && npm run plugin:build",
    "plugin:build": "tsc -p plugins/incidentos/tsconfig.json",
    "plugin:pack": "cd plugins/incidentos && npm pack --dry-run --cache ../../.npm-cache",
    "test": "vitest run",
    "verify": "npm run test && npm run build && npm run plugin:pack"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "vite": "7.1.9",
    "typescript": "5.9.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "lucide-react": "0.468.0"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "vitest": "3.2.4",
    "jsdom": "27.0.0"
  }
}
